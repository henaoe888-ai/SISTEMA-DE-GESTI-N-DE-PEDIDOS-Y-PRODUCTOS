AHORA EXPLICARE ALGO SOBRE LOS USUARIOS simplemente se hace lo mismo solo que los views cambian y adicional no
necesariamente se crean modelos

from django.shortcuts import render, redirect
from django.contrib.auth import authenticate, login, logout
from django.contrib.auth.models import User


def iniciar_sesion(request):

    if request.method == "POST":

        usuario = authenticate(request,
        username = request.POST["username"],
        password = request.POST["password"]
        )

        if usuario is not None: <-si el usuario no tiene datos nulos, puede acceder a la lista y crear, modificar, ver o cerrar sesión
            login(request, usuario)
            destino = request.GET.get("next", "/productos/listar/") <- aca es donde se manda a la lista que permite ver los pedidos creados y crear nuevos pedidos y demás
            return redirect(destino)

        return render(
            request,
            "usuarios/login.html",
            {"error": "Usuario o contraseña incorrectos"} <-si se detecta errores vuelve y manda a la persona a inciar sesion otra vez
        )

    return render(
        request,
        "usuarios/login.html", <-especificamente es la ruta en donde lo manda a volver a inicar sesion
    )

def registro(request):

    if request.method == "POST":

        username = request.POST["username"]
        email = request.POST["email"]
        password1 = request.POST["password1"]
        password2 = request.POST["password2"]

        if password1 != password2: <--verificamos que la contraseña puesta la primera vez coincidan con el segundo campo

            return render(
                request,
                "usuarios/registro.html",
                {"error": "Las contraseñas no coinciden"} <-- en casos de errores muestra el mensaje de que la contraseña es invalida
            )

        if User.objects.filter(username=username).exists(): <- verifica si el usuario esta existente o inexistente

            return render(
                request,
                "usuarios/registro.html",
                {"error": "Ese usuario ya existe"} <- en caso de que no muestra mensaje
            )

        usuario = User.objects.create_user(
            username=username,
            email=email,
            password=password1                <-si los datos son correctos y válidos
        )

        login(request, usuario)  <- indica que el usuario si se registro, y que puede inciar sesion

        return redirect("/productos/crear/") <-lo mando a la lista que e spor asi decirlo la parte principal de la pagina

    return render(
        request,
        "usuarios/registro.html"
    )  <-datos ingresados en el registro seran enviados automaticamente a la base de datos


def cerrar_sesion(request):
    logout(request)
    return redirect("/usuarios/login/") <-destruye una sesión iniciado o una cuenta que este dentro de la pagina

-- luego vienen las urls auque es lo mismo que hicimos con los metodos de las views o acciones por asi decirlo

creamos un archivo llamado urls.py y metemos lo siguiente dentro de ella:

from django.urls import path
from . import views

urlpatterns = [
    path("login/", views.iniciar_sesion),
    path("registro/", views.registro),
    path("logout/", views.cerrar_sesion),
]

esto para que nos redireccione hacia las diferente rutas que tenemos como iniciar sesion, registro o cerrar la sesion

-- y ya como paso final se crean las plantillas de usuarios, creamos dentro de usuarios una carpeta
llamada template luego otra dentro de esta llamada usuarios y dentro de ella los html (login.html = inicio de sesión, registro.html = registro)

==================== PLANTILLA LOGIN HTML =====================

